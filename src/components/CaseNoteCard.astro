---
import type { CaseNote } from '../lib/content';
import { fmtDate, LANE_LABEL, noteTitle } from '../lib/content';
interface Props { note: CaseNote }
const { note } = Astro.props;
---
<article class="panel flex flex-col p-5">
  <p class="flex flex-wrap gap-2"><span class="tag">{LANE_LABEL[note.data.lane]}</span><span class="tag">{note.data.sector}</span></p>
  <h3 class="mt-3 text-base"><a href={`/case-notes/${note.id}`} class="text-ink no-underline hover:underline">{noteTitle(note.data.title)}</a></h3>
  <p class="muted mt-2 flex-1 text-sm">{note.data.summary}</p>
  <p class="mono mt-3 text-xs muted"><time datetime={note.data.published.toISOString()}>{fmtDate(note.data.published)}</time> · illustrative composite</p>
</article>
