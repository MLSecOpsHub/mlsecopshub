---
import { SITE } from '../config/site';
import { HOLDING_PAGE } from '../config/holding.mjs';
interface Props {
  title: string;
  description: string;
  path: string;
  canonical?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  published?: Date;
  updated?: Date;
}
const { title, description, path, canonical, ogImage, type = 'website', noindex = false, published, updated } = Astro.props;
if (title.length > 60) throw new Error(`Title too long (${title.length}): ${title}`);
if (description.length < 140 || description.length > 155) throw new Error(`Meta description must be 140–155 chars (${description.length}): ${path}`);
const url = `${SITE.url}${path === '/' ? '' : path}`;
const canonicalUrl = canonical ?? (path === '/' ? `${SITE.url}/` : url);
const image = ogImage ?? `${SITE.url}/og${path === '/' ? '/home' : path}.png`;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" hreflang="en" href={canonicalUrl} />
<link rel="alternate" hreflang="x-default" href={canonicalUrl} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta name="theme-color" content="#0B1220" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#F7F9FC" media="(prefers-color-scheme: light)" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
{!HOLDING_PAGE && <link rel="alternate" type="application/rss+xml" title="MLSecOpsHub blog" href="/blog/rss.xml" />}
{!HOLDING_PAGE && <link rel="alternate" type="application/rss+xml" title="MLSecOpsHub case notes" href="/case-notes/rss.xml" />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
{published && <meta property="article:published_time" content={published.toISOString()} />}
{updated && <meta property="article:modified_time" content={updated.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@MLSecOpsHacker" />
<meta name="twitter:creator" content="@MLSecOpsHacker" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
{SITE.analyticsDomain && <script defer data-domain={SITE.analyticsDomain} src={SITE.analyticsScript} is:inline></script>}
