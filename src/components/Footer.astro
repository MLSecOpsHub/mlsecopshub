---
import { SITE, NAV, utm } from '../config/site';
import NewsletterForm from './NewsletterForm.astro';
import { HOLDING_PAGE } from '../config/holding.mjs';
const year = new Date().getFullYear();
---
{HOLDING_PAGE ? (
<footer class="mt-20 border-t border-line bg-panel">
  <div class="wrap py-10">
    <div class="grid gap-8 md:grid-cols-[1.4fr_1fr]">
      <div>
        <p class="kicker">MLSecOpsHub</p>
        <p class="mt-3 max-w-prose text-ink">A GitHub organization and community building open-source MLSecOps and AI security tooling, datasets and research, and the home of The MLSecOps Hacker newsletter.</p>
      </div>
      <nav aria-label="Footer">
        <p class="kicker">Elsewhere</p>
        <ul class="mt-3 space-y-1.5 text-sm">
          <li><a href={utm(SITE.github.org)} rel="me noopener" class="text-muted hover:text-ink plausible-event-name=GitHub+Click">GitHub: {SITE.github.orgName}</a></li>
          <li><a href={utm(SITE.social.substack)} rel="me noopener" class="text-muted hover:text-ink plausible-event-name=Newsletter+Click">Substack: {SITE.newsletter.name}</a></li>
          <li><a href={SITE.social.x} rel="me noopener" class="text-muted hover:text-ink">X: @MLSecOpsHacker</a></li>
          <li><a href="/privacy" class="text-muted hover:text-ink">Privacy</a> · <a href="/imprint" class="text-muted hover:text-ink">Imprint</a> · <a href="/llms.txt" class="text-muted hover:text-ink">llms.txt</a></li>
        </ul>
      </nav>
    </div>
    <p class="mono mt-8 text-xs muted">© {year} {SITE.legalName}. No cookies, no trackers: analytics is cookieless and aggregated.</p>
  </div>
</footer>
) : (
<footer class="mt-20 border-t border-line bg-panel">
  <div class="wrap py-12">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <p class="kicker">MLSecOpsHub</p>
        <p class="mt-3 max-w-prose text-ink">MLSecOpsHub is an MLSecOps and AI security practice: assessments of AI systems, hardening of ML pipelines, and governance readiness for the EU AI Act, Cyber Resilience Act, NIST AI RMF and ISO/IEC 42001.</p>
        <p class="mt-4 flex flex-wrap gap-3">
          <a href={SITE.bookingUrl} class="btn btn-primary plausible-event-name=Booking+Click" data-goal="booking" rel="noopener">{SITE.cta.booking}</a>
          <a href={utm(SITE.newsletter.url)} class="btn btn-secondary plausible-event-name=Newsletter+Click" rel="noopener">Read the newsletter</a>
        </p>
        <div class="mt-6 max-w-md"><NewsletterForm compact id="footer-nl" /></div>
      </div>
      <nav aria-label="Footer">
        <p class="kicker">Site</p>
        <ul class="mt-3 space-y-1.5 text-sm">
          {NAV.map((i) => <li><a href={i.href} class="text-muted hover:text-ink">{i.label}</a></li>)}
          <li><a href="/blog" class="text-muted hover:text-ink">Blog</a></li>
          <li><a href="/contact" class="text-muted hover:text-ink">Contact</a></li>
          <li><a href="/privacy" class="text-muted hover:text-ink">Privacy</a></li>
          <li><a href="/imprint" class="text-muted hover:text-ink">Imprint</a></li>
        </ul>
      </nav>
      <div>
        <p class="kicker">Elsewhere</p>
        <ul class="mt-3 space-y-1.5 text-sm">
          <li><a href={utm(SITE.github.org)} rel="me noopener" class="text-muted hover:text-ink plausible-event-name=GitHub+Click">GitHub: {SITE.github.orgName}</a></li>
          <li><a href={utm(SITE.github.listUrl)} rel="noopener" class="text-muted hover:text-ink plausible-event-name=GitHub+Click">awesome-MLSecOps list</a></li>
          <li><a href={SITE.social.awesome} rel="noopener" class="text-muted hover:text-ink">awesomemlsecops.com: tools, resources, glossary</a></li>
          <li><a href={utm(SITE.social.substack)} rel="me noopener" class="text-muted hover:text-ink plausible-event-name=Newsletter+Click">Substack: {SITE.newsletter.name}</a></li>
          <li><a href={SITE.social.x} rel="me noopener" class="text-muted hover:text-ink">X: @MLSecOpsHacker</a></li>
          <li><a href={SITE.social.instagram} rel="me noopener" class="text-muted hover:text-ink">Instagram: @aisecurity.hacker</a></li>
          <li><a href="/blog/rss.xml" class="text-muted hover:text-ink">RSS: blog</a> · <a href="/case-notes/rss.xml" class="text-muted hover:text-ink">RSS: case notes</a> · <a href="/llms.txt" class="text-muted hover:text-ink">llms.txt</a></li>
        </ul>
      </div>
    </div>
    <p class="mono mt-10 text-xs muted">© {year} {SITE.legalName}. Remote-first, EU and APAC time zones. No cookies, no trackers: analytics is cookieless and aggregated.</p>
  </div>
</footer>
)}
