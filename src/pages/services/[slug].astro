---
import { render, getEntries } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import { SITE } from '../../config/site';
import { getServices, getCaseNotes, noteTitle } from '../../lib/content';
import { webPage, breadcrumbs, faqPage, service as serviceLd } from '../../lib/jsonld';

export async function getStaticPaths() {
  return (await getServices()).map((s) => ({ params: { slug: s.id }, props: { entry: s } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const path = `/services/${entry.id}`;
const readiness = await getEntries(entry.data.readiness);
const notes = (await getCaseNotes()).filter((n) => n.data.service.id === entry.id);
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Services', path: '/services' }, { name: entry.data.shortTitle, path }];
const graph = [
  webPage(path, entry.data.title, entry.data.description),
  breadcrumbs(crumbs),
  serviceLd({ path, name: entry.data.shortTitle, description: entry.data.summary, serviceType: entry.data.serviceType }),
  faqPage(entry.data.faq, path),
];
---
<Base title={entry.data.title} description={entry.data.description} {path} graph={graph} updated={entry.data.updated}>
  <section class="wrap py-12 md:py-16">
    <Breadcrumbs items={crumbs} />
    <p class="kicker mt-6">Service · {entry.data.serviceType}</p>
    <h1 class="mt-3">{entry.data.shortTitle}</h1>
    <p class="answer mt-5">{entry.data.answer}</p>
    <dl class="mt-8 grid gap-4 sm:grid-cols-3 max-w-3xl">
      <div class="panel p-4"><dt class="stat-label">Duration</dt><dd class="mt-1 text-sm">{entry.data.duration}</dd></div>
      <div class="panel p-4"><dt class="stat-label">Pricing</dt><dd class="mt-1 text-sm">Fixed-scope, quoted after a 30-minute call</dd></div>
      <div class="panel p-4"><dt class="stat-label">How we work</dt><dd class="mt-1 text-sm">Remote-first, EU and APAC time zones</dd></div>
    </dl>
  </section>

  <div class="wrap"><CtaBlock id="svc-cta" heading={SITE.cta.booking} body="30 minutes to describe the system, its integrations and the deadline. You receive a written scope and a fixed quote within two working days." /></div>

  <section class="wrap py-14 grid gap-12 lg:grid-cols-[2fr_1fr]">
    <div class="space-y-12">
      <section aria-labelledby="for-h">
        <h2 id="for-h">Who it is for</h2>
        <ul class="mt-4 space-y-2 list-disc pl-5">{entry.data.forWho.map((f) => <li>{f}</li>)}</ul>
      </section>
      <section aria-labelledby="scope-h">
        <h2 id="scope-h">What is delivered: the scope</h2>
        <ol class="mt-4 space-y-3 list-decimal pl-5 marker:font-mono marker:text-accent">{entry.data.scope.map((s) => <li>{s}</li>)}</ol>
      </section>
      <section aria-labelledby="provide-h">
        <h2 id="provide-h">What the client provides</h2>
        <ul class="mt-4 space-y-2 list-disc pl-5">{entry.data.clientProvides.map((c) => <li>{c}</li>)}</ul>
      </section>
      <section aria-labelledby="deliver-h">
        <h2 id="deliver-h">Deliverable examples</h2>
        <ul class="mt-4 space-y-2 list-disc pl-5">{entry.data.deliverables.map((d) => <li>{d}</li>)}</ul>
      </section>
      <section aria-labelledby="how-h">
        <h2 id="how-h">How MLSecOpsHub works</h2>
        <ul class="mt-4 space-y-2 list-disc pl-5">
          <li>Remote-first. Working hours overlap EU and APAC time zones; overlap windows are agreed at kickoff.</li>
          <li>Written scope and written authorization before any testing or code change.</li>
          <li>A shared channel and shared repository for the duration, so every finding, question and decision has a record.</li>
          <li>Fixed-scope, quoted after a 30-minute call. No prices on this page because the scope decides the price.</li>
        </ul>
      </section>
      <div class="prose"><Content /></div>
      <Faq items={entry.data.faq} id="svc-faq" />
    </div>
    <aside class="space-y-6 lg:sticky lg:top-24 self-start">
      <div class="panel p-5">
        <p class="kicker">Readiness</p>
        <p class="muted mt-2 text-sm">Frameworks this engagement produces evidence for:</p>
        <ul class="mt-2 space-y-1.5 text-sm">{readiness.map((r) => <li><a href={`/readiness/${r.id}`}>{r.data.shortTitle}</a></li>)}</ul>
      </div>
      {notes.length > 0 && (
        <div class="panel p-5">
          <p class="kicker">Case notes</p>
          <ul class="mt-2 space-y-1.5 text-sm">{notes.map((n) => <li><a href={`/case-notes/${n.id}`}>{noteTitle(n.data.title)}</a></li>)}</ul>
        </div>
      )}
      <div class="panel p-5">
        <p class="kicker">Evidence</p>
        <p class="muted mt-2 text-sm">Disclosed incidents this work is designed to prevent: the <a href="/data">Agentic Attack Index</a>.</p>
      </div>
    </aside>
  </section>
  <div class="wrap pb-6"><CtaBlock id="svc-cta-2" variant="plain" /></div>
</Base>
