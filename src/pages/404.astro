---
import Base from '../layouts/Base.astro';
import { webPage } from '../lib/jsonld';
import { SITE, utm } from '../config/site';
import { HOLDING_PAGE } from '../config/holding.mjs';
const title = 'Page not found | MLSecOpsHub';
const description = HOLDING_PAGE
  ? 'The page you requested does not exist on mlsecopshub.com. Go back to the home page for the MLSecOpsHub GitHub projects and The MLSecOps Hacker newsletter.'
  : 'The page you requested does not exist on mlsecopshub.com. Use the links to reach the services, readiness pages, case notes or the Agentic Attack Index.';
---
<Base {title} {description} path="/404" graph={[webPage('/404', title, description)]} noindex>
  <section class="wrap py-16">
    <p class="kicker">HTTP 404</p>
    <h1 class="mt-3">Page not found</h1>
    <p class="answer mt-5">Nothing lives at this address. If you followed a link from another site, it may point at the newsletter or the tools directory instead.</p>
    {HOLDING_PAGE ? (
      <ul class="mt-6 grid gap-2 sm:grid-cols-2 max-w-xl text-sm">
        <li><a href="/">Home</a></li>
        <li><a href={utm(SITE.github.org)} rel="noopener">GitHub: {SITE.github.orgName}</a></li>
        <li><a href={utm(SITE.newsletter.url)} rel="noopener">Newsletter: {SITE.newsletter.name}</a></li>
      </ul>
    ) : (
      <ul class="mt-6 grid gap-2 sm:grid-cols-2 max-w-xl text-sm">
        <li><a href="/services">Services</a></li>
        <li><a href="/readiness">Readiness hub</a></li>
        <li><a href="/case-notes">Case notes</a></li>
        <li><a href="/data">Agentic Attack Index</a></li>
        <li><a href="/newsletter">Newsletter</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    )}
  </section>
</Base>
