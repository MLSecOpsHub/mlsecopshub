---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BookingEmbed from '../../components/BookingEmbed.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { SITE } from '../../config/site';
import { webPage, breadcrumbs } from '../../lib/jsonld';

const title = 'Contact MLSecOpsHub: Book an AI Security Call';
const description =
  'Contact MLSecOpsHub to book a 30-minute assessment call, email the practice directly, or send a short message about an AI security or MLSecOps engagement.';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Contact', path: '/contact' }];
const graph = [webPage('/contact', title, description, 'ContactPage'), breadcrumbs(crumbs)];
---
<Base {title} {description} path="/contact" graph={graph}>
  <section class="wrap py-12 md:py-16">
    <Breadcrumbs items={crumbs} />
    <p class="kicker mt-6">Contact</p>
    <h1 class="mt-3">Contact MLSecOpsHub</h1>
    <p class="answer mt-5">
      <strong>MLSecOpsHub</strong> takes new engagements through a 30-minute call, by email, or through the two-field form below. Describe the system, its integrations and any deadline. You receive a written scope and a fixed quote within two working days, or a straight answer that you do not need an engagement.
    </p>
  </section>

  <section class="wrap grid gap-8 pb-14 lg:grid-cols-2">
    <BookingEmbed />
    <div class="space-y-8">
      <div class="panel p-6">
        <p class="kicker">Email</p>
        <p class="mt-2"><a href={`mailto:${SITE.contactEmail}`} class="mono">{SITE.contactEmail}</a></p>
        <p class="muted mt-1 text-sm">Encrypted email on request. Do not send credentials or production data; a description of the architecture is enough for scoping.</p>
      </div>
      <form method="post" action={SITE.formEndpoint} class="panel p-6 space-y-4" aria-labelledby="form-h" data-goal="form">
        <p class="kicker">Message</p>
        <h2 id="form-h" class="text-lg">Write first, book later</h2>
        <div>
          <label for="c-email">Your email</label>
          <input id="c-email" name="email" type="email" required autocomplete="email" inputmode="email" />
        </div>
        <div>
          <label for="c-message">Message</label>
          <textarea id="c-message" name="message" rows="6" required minlength="20" maxlength="4000" placeholder="What are you shipping, what worries you, and when do you need an answer?"></textarea>
        </div>
        <div class="visually-hidden" aria-hidden="true">
          <label for="c-website">Leave this field empty</label>
          <input id="c-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <button type="submit" class="btn btn-primary" data-event="Form Submit">Send message</button>
        <p class="muted text-xs">No CAPTCHA. Automated submissions are filtered server-side with a hidden field, which never blocks keyboard or screen-reader users. See the <a href="/privacy">privacy notice</a>.</p>
      </form>
      <div class="panel p-6">
        <p class="kicker">Not ready to talk</p>
        <div class="mt-3"><NewsletterForm compact id="contact-nl" /></div>
      </div>
    </div>
  </section>
</Base>
