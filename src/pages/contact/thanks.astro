---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config/site';
import { webPage } from '../../lib/jsonld';
const title = 'Message received | MLSecOpsHub';
const description = 'Your message to MLSecOpsHub has been received. You will hear back within two working days. Book a 30-minute assessment call if you would rather talk first.';
---
<Base {title} {description} path="/contact/thanks" graph={[webPage('/contact/thanks', title, description)]} noindex>
  <section class="wrap py-16">
    <p class="kicker">Contact</p>
    <h1 class="mt-3">Message received</h1>
    <p class="answer mt-5">Thank you. MLSecOpsHub replies within two working days. If you would rather talk first, the calendar is open.</p>
    <p class="mt-6 flex flex-wrap gap-3">
      <a href={SITE.bookingUrl} class="btn btn-primary plausible-event-name=Booking+Click" rel="noopener">{SITE.cta.booking}</a>
      <a href="/" class="btn btn-secondary">Back to the home page</a>
    </p>
  </section>
</Base>
