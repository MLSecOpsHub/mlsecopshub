---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import { SITE, utm } from '../../config/site';
import { webPage, breadcrumbs, faqPage, ORG_ID } from '../../lib/jsonld';

const ds = await getEntry('datasets', 'agentic-attack-index');
if (!ds) throw new Error('datasets/agentic-attack-index missing');
const { Content } = await render(ds);
const rows = (await getCollection('attackIndex')).map((e) => e.data).sort((a, b) => (a.disclosed < b.disclosed ? 1 : -1));
const VECTOR: Record<string, string> = {
  'indirect-prompt-injection': 'Indirect prompt injection',
  'direct-prompt-injection': 'Direct prompt injection',
  'tool-permission-abuse': 'Tool permission abuse',
  'mcp-server-compromise': 'MCP server compromise',
  'data-exfiltration': 'Data exfiltration',
  'agent-hijacking': 'Agent hijacking',
};
const byVector = Object.entries(rows.reduce<Record<string, number>>((m, r) => ((m[r.vector] = (m[r.vector] ?? 0) + 1), m), {})).sort((a, b) => b[1] - a[1]);
const byYear = Object.entries(rows.reduce<Record<string, number>>((m, r) => ((m[r.disclosed.slice(0, 4)] = (m[r.disclosed.slice(0, 4)] ?? 0) + 1), m), {})).sort();
const path = '/data';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Data', path }];
const graph = [
  webPage(path, ds.data.title, ds.data.description),
  breadcrumbs(crumbs),
  {
    '@type': 'Dataset',
    '@id': `${SITE.url}${path}#dataset`,
    name: ds.data.name,
    description: ds.data.answer,
    url: `${SITE.url}${path}`,
    sameAs: ds.data.repoUrl,
    license: ds.data.license,
    isAccessibleForFree: true,
    creator: { '@id': ORG_ID },
    publisher: { '@id': ORG_ID },
    datePublished: ds.data.published.toISOString().slice(0, 10),
    dateModified: ds.data.updated.toISOString().slice(0, 10),
    keywords: ['prompt injection', 'AI agent security', 'Model Context Protocol', 'MLSecOps', 'LLM security incidents'],
    variableMeasured: ds.data.columns.map((c) => ({ '@type': 'PropertyValue', name: c.key, description: c.description })),
    distribution: [
      { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: ds.data.rawUrl },
      { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: `${SITE.url}/data/agentic-attack-index.json` },
    ],
    temporalCoverage: `${rows[rows.length - 1]?.disclosed}/${rows[0]?.disclosed}`,
  },
  faqPage(ds.data.faq, path),
];
---
<Base title={ds.data.title} description={ds.data.description} {path} graph={graph} updated={ds.data.updated}>
  <section class="wrap py-12 md:py-16">
    <Breadcrumbs items={crumbs} />
    <p class="kicker mt-6">Data · {ds.data.name}</p>
    <h1 class="mt-3">Agentic Attack Index: documented prompt injection and AI agent incidents</h1>
    <p class="answer mt-5">{ds.data.answer}</p>
    <dl class="mt-8 grid gap-4 sm:grid-cols-4 max-w-4xl">
      <div class="panel p-4"><dt class="stat-label">Entries</dt><dd class="stat mt-1">{rows.length}</dd></div>
      <div class="panel p-4"><dt class="stat-label">Coverage</dt><dd class="stat mt-1 text-xl">{byYear[0]?.[0]}–{byYear[byYear.length - 1]?.[0]}</dd></div>
      <div class="panel p-4"><dt class="stat-label">Top vector</dt><dd class="mt-1 text-sm font-semibold">{VECTOR[byVector[0]?.[0] ?? ''] ?? ''} ({byVector[0]?.[1]})</dd></div>
      <div class="panel p-4"><dt class="stat-label">License</dt><dd class="mt-1 text-sm font-semibold"><a href={ds.data.license} rel="noopener">CC BY 4.0</a></dd></div>
    </dl>
    <p class="mt-6 flex flex-wrap gap-3">
      <a href={utm(ds.data.repoUrl)} class="btn btn-secondary plausible-event-name=GitHub+Click" rel="noopener">Repository on GitHub</a>
      <a href="/data/agentic-attack-index.json" class="btn btn-secondary plausible-event-name=PDF+Download" data-goal="json">Raw JSON</a>
      <a href="/data/agentic-attack-index.csv" class="btn btn-secondary plausible-event-name=PDF+Download" data-goal="csv">CSV</a>
    </p>
  </section>

  <section class="wrap pb-14" aria-labelledby="table-h">
    <h2 id="table-h" class="text-lg">All entries</h2>
    <p class="muted mt-1 text-sm">Click a column header to sort. Sorted by disclosure date, newest first, by default.</p>
    <div class="mt-4 overflow-x-auto">
      <table class="sortable" id="aai">
        <thead>
          <tr>
            <th scope="col" aria-sort="descending" data-key="disclosed">Disclosed</th>
            <th scope="col" data-key="product">Product</th>
            <th scope="col" data-key="vector">Vector</th>
            <th scope="col" data-key="surface">Surface</th>
            <th scope="col" data-key="impact">Impact</th>
            <th scope="col" data-key="status">Status</th>
            <th scope="col">Source</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr id={r.id}>
              <td class="mono text-xs whitespace-nowrap" data-value={r.disclosed}>{r.disclosed}</td>
              <td><span class="font-semibold text-ink">{r.product}</span><br /><span class="muted text-xs">{r.vendor}</span><p class="muted mt-1 text-xs max-w-xs">{r.summary}</p></td>
              <td data-value={r.vector}><span class="tag">{VECTOR[r.vector]}</span></td>
              <td class="text-sm">{r.surface}</td>
              <td class="text-sm">{r.impact}</td>
              <td class="mono text-xs" data-value={r.status}>{r.status}</td>
              <td class="text-xs"><a href={r.source} rel="noopener nofollow">{r.sourceName}</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <div class="wrap"><CtaBlock id="data-cta" heading="Which of these could happen to your agent?" body="The index shows the patterns. An AI security assessment shows which ones apply to your system, with a reproduction, not a guess." /></div>

  <section class="wrap py-14 grid gap-12 lg:grid-cols-[2fr_1fr]">
    <div class="prose">
      <h2>About the index</h2>
      <Content />
      <h2>Fields</h2>
      <dl>
        {ds.data.columns.map((c) => (<><dt class="mono text-sm text-accent">{c.key}</dt><dd class="muted mb-3">{c.description}</dd></>))}
      </dl>
      <h2>Inclusion criteria</h2>
      <ul>
        <li>The target is an LLM application, an AI agent, or a Model Context Protocol server or client.</li>
        <li>The incident or vulnerability is publicly documented by a primary source: the researcher, the vendor or a CVE record.</li>
        <li>The mechanism involves untrusted content reaching the model, or a tool with more privilege than the task required.</li>
      </ul>
      <h2>Citation</h2>
      <p>MLSecOpsHub, <em>Agentic Attack Index</em>, <a href={`${SITE.url}/data`}>{SITE.url}/data</a>, accessed on the date of use. Licensed <a href={ds.data.license} rel="noopener">CC BY 4.0</a>. Corrections and additions: open an issue or pull request in the <a href={utm(ds.data.repoUrl)} rel="noopener">GitHub repository</a>.</p>
      <Faq items={ds.data.faq} id="data-faq" />
    </div>
    <aside class="space-y-6 self-start lg:sticky lg:top-24">
      <div class="panel p-5">
        <p class="kicker">By vector</p>
        <ul class="mt-2 space-y-1 text-sm">{byVector.map(([v, n]) => <li class="flex justify-between gap-3"><span>{VECTOR[v]}</span><span class="mono muted">{n}</span></li>)}</ul>
      </div>
      <div class="panel p-5">
        <p class="kicker">By year</p>
        <ul class="mt-2 space-y-1 text-sm">{byYear.map(([y, n]) => <li class="flex justify-between gap-3"><span>{y}</span><span class="mono muted">{n}</span></li>)}</ul>
      </div>
      <div class="panel p-5">
        <p class="kicker">Related</p>
        <ul class="mt-2 space-y-1.5 text-sm">
          <li><a href="/services/ai-security-assessment">AI security assessment</a></li>
          <li><a href="/readiness/nist-ai-rmf">NIST AI RMF controls</a></li>
          <li><a href="/case-notes/mcp-server-overbroad-permissions">Case note: MCP server permissions</a></li>
          <li><a href={SITE.social.awesome} rel="noopener">Tools and resources on awesomemlsecops.com</a></li>
        </ul>
      </div>
    </aside>
  </section>
</Base>
<script>
  // Progressive enhancement: the table is fully readable without this.
  const table = document.getElementById('aai') as HTMLTableElement | null;
  if (table) {
    const tbody = table.tBodies[0];
    table.querySelectorAll<HTMLTableCellElement>('th[data-key]').forEach((th, idx) => {
      const label = th.textContent ?? '';
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.textContent = label;
      btn.setAttribute('aria-label', `Sort by ${label}`);
      th.textContent = '';
      th.appendChild(btn);
      btn.addEventListener('click', () => {
        const dir = th.getAttribute('aria-sort') === 'ascending' ? 'descending' : 'ascending';
        table.querySelectorAll('th').forEach((h) => h.removeAttribute('aria-sort'));
        th.setAttribute('aria-sort', dir);
        const val = (tr: HTMLTableRowElement) => {
          const cell = tr.cells[idx];
          return (cell.dataset.value ?? cell.textContent ?? '').trim().toLowerCase();
        };
        Array.from(tbody.rows)
          .sort((a, b) => (dir === 'ascending' ? 1 : -1) * val(a).localeCompare(val(b)))
          .forEach((tr) => tbody.appendChild(tr));
      });
    });
  }
</script>
