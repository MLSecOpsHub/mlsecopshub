---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../config/site';
import { webPage, breadcrumbs } from '../lib/jsonld';
import { HOLDING_PAGE } from '../config/holding.mjs';
const title = 'Privacy Notice | MLSecOpsHub';
const description = HOLDING_PAGE
  ? 'How mlsecopshub.com handles personal data: cookieless analytics, newsletter signup handled by Substack, short-lived hosting logs and your GDPR rights.'
  : 'How mlsecopshub.com handles personal data: cookieless analytics, the contact form, newsletter signup handled by Substack and booking handled by Cal.com.';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Privacy', path: '/privacy' }];
---
<Base {title} {description} path="/privacy" graph={[webPage('/privacy', title, description), breadcrumbs(crumbs)]}>
  <section class="wrap-narrow py-12 md:py-16">
    <Breadcrumbs items={crumbs} />
    <p class="kicker mt-6">Legal</p>
    <h1 class="mt-3">Privacy notice</h1>
    <p class="answer mt-5">mlsecopshub.com sets no cookies and uses no advertising trackers. Analytics is cookieless and aggregated. {HOLDING_PAGE ? 'Personal data is processed only when you subscribe to the newsletter on Substack or email the address below.' : 'Personal data is processed only when you send the contact form, subscribe to the newsletter on Substack, or book a call on Cal.com.'}</p>
    <div class="prose mt-8">
      <h2>Controller</h2>
      <p>{SITE.legalName}, see the <a href="/imprint">imprint</a> for the legal entity and address. Contact: <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.</p>
      <h2>Analytics</h2>
      <p>This site uses Plausible Analytics, a privacy-focused service that does not use cookies and does not collect personal data or persistent identifiers. Page views and outbound clicks are counted in aggregate. No consent banner is required because no data that identifies you is stored. Plausible's data policy is published at <a href="https://plausible.io/data-policy" rel="noopener">plausible.io/data-policy</a>.</p>
      {!HOLDING_PAGE && (
        <>
          <h2>Contact form</h2>
          <p>The form sends your email address and message to MLSecOpsHub by email through a serverless function. A hidden form field is used to filter automated submissions; it does not identify you. Your message is kept for as long as needed to answer it and for any engagement that follows, and deleted on request.</p>
        </>
      )}
      <h2>Newsletter</h2>
      <p>The newsletter subscription form posts your email address directly to Substack, which acts as the processor for The MLSecOps Hacker. Substack's privacy policy applies to that data. You can unsubscribe from any issue.</p>
      {!HOLDING_PAGE && (
        <>
          <h2>Booking</h2>
          <p>The booking page is provided by Cal.com. The embedded calendar loads only after you choose to show it. Data you enter when booking is processed by Cal.com under its privacy policy and shared with MLSecOpsHub to hold the meeting.</p>
        </>
      )}
      <h2>Hosting and logs</h2>
      <p>The site is served as static files from a content delivery network, which may keep short-lived request logs including IP addresses for security and operations. Security headers restrict what third-party resources the pages can load.</p>
      <h2>Your rights</h2>
      <p>Where the GDPR or a similar law applies, you can request access, correction, deletion or a copy of your data, and object to processing, by writing to the contact address above.</p>
      <p class="mono text-xs">Last updated 2026-09-08.</p>
    </div>
  </section>
</Base>
