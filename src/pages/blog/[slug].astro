---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getPosts, fmtDate } from '../../lib/content';
import { webPage, breadcrumbs, article } from '../../lib/jsonld';

export async function getStaticPaths() {
  return (await getPosts()).map((p) => ({ params: { slug: p.id }, props: { entry: p } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const path = `/blog/${entry.id}`;
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog' }, { name: entry.data.title, path }];
const graph = [
  webPage(path, entry.data.title, entry.data.description),
  breadcrumbs(crumbs),
  article({ path, headline: entry.data.title, description: entry.data.description, published: entry.data.published, updated: entry.data.updated, type: 'BlogPosting', keywords: entry.data.tags }),
];
---
<Base title={entry.data.title} description={entry.data.description} {path} graph={graph} type="article" canonical={entry.data.canonical} published={entry.data.published} updated={entry.data.updated}>
  <article class="wrap py-12 md:py-16">
    <Breadcrumbs items={crumbs} />
    <p class="kicker mt-6">Blog · {entry.data.tags.join(', ')}</p>
    <h1 class="mt-3">{entry.data.title}</h1>
    <p class="mono mt-3 text-xs muted">Published <time datetime={entry.data.published.toISOString()}>{fmtDate(entry.data.published)}</time>{entry.data.canonical && <> · Originally published at <a href={entry.data.canonical} rel="noopener">{new URL(entry.data.canonical).hostname}</a></>}</p>
    <div class="prose mt-8"><Content /></div>
  </article>
  <div class="wrap"><CtaBlock id="post-cta" /></div>
</Base>
