---
import Base from '../layouts/Base.astro';
import CtaBlock from '../components/CtaBlock.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { SITE, utm } from '../config/site';
import { getNewsletter } from '../lib/substack';
import { fmtDate } from '../lib/content';
import { webPage, breadcrumbs } from '../lib/jsonld';

const title = 'The MLSecOps Hacker Newsletter: AI Security Biweekly';
const description =
  'The MLSecOps Hacker is the biweekly AI security newsletter from MLSecOpsHub: MLSecOps practice, model supply-chain attacks, prompt injection, governance.';
const nl = await getNewsletter();
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Newsletter', path: '/newsletter' }];
const graph = [webPage('/newsletter', title, description), breadcrumbs(crumbs)];
---
<Base {title} {description} path="/newsletter" graph={graph}>
  <section class="wrap py-12 md:py-16">
    <Breadcrumbs items={crumbs} />
    <p class="kicker mt-6">Newsletter</p>
    <h1 class="mt-3">The MLSecOps Hacker: AI security every two weeks</h1>
    <p class="answer mt-5">
      <strong>The MLSecOps Hacker</strong> is the newsletter of MLSecOpsHub, written by Riccardo Biosas and published on Substack every two weeks. It covers MLSecOps practice, model supply-chain attacks, prompt injection, agent and MCP security and AI governance, for CISOs, security engineers and ML engineers. It is free, and {nl.count} issues have been published.
    </p>
    <div class="mt-8 max-w-xl"><NewsletterForm id="nl-page" /></div>
    <p class="mono mt-3 text-xs muted">Subscribing sends your address to Substack only. Read the <a href={utm(SITE.newsletter.url)} rel="noopener">archive on Substack</a> without subscribing.</p>
  </section>

  <div class="wrap"><CtaBlock id="nl-cta" /></div>

  <section class="wrap py-14" aria-labelledby="issues-h">
    <h2 id="issues-h">Latest issues</h2>
    <p class="muted mt-1 text-sm">Titles are read from the Substack feed at build time. Each link opens the issue on Substack, which is the canonical home for all newsletter content.</p>
    <ol class="mt-6 divide-y divide-line border-y border-line">
      {nl.issues.map((i) => (
        <li class="grid gap-1 py-4 sm:grid-cols-[8rem_1fr]">
          <time datetime={i.date} class="mono text-xs muted">{fmtDate(i.date)}</time>
          <div>
            <a href={utm(i.url)} rel="noopener" class="font-semibold text-ink plausible-event-name=Newsletter+Click">{i.title}</a>
            {i.summary && <p class="muted mt-1 text-sm">{i.summary}</p>}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap pb-14" aria-labelledby="embed-h">
    <h2 id="embed-h" class="text-lg">Subscribe with the Substack embed</h2>
    <p class="muted mt-1 text-sm">The embed loads from Substack only when it scrolls into view. The form above works without it.</p>
    <iframe src={SITE.newsletter.embed} width="480" height="320" loading="lazy" title="Subscribe to The MLSecOps Hacker on Substack" class="mt-4 max-w-full rounded border border-line bg-panel"></iframe>
  </section>
</Base>
