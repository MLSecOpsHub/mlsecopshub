---
import { render, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaBlock from '../../components/CtaBlock.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Faq from '../../components/Faq.astro';
import { getReadiness, getCaseNotes, noteTitle } from '../../lib/content';
import { webPage, breadcrumbs, faqPage, article } from '../../lib/jsonld';

export async function getStaticPaths() {
  return (await getReadiness()).map((r) => ({ params: { slug: r.id }, props: { entry: r } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const path = `/readiness/${entry.id}`;
const service = await getEntry(entry.data.service);
if (!service) throw new Error(`Unknown service reference on ${entry.id}`);
const notes = (await getCaseNotes()).filter((n) => n.data.readiness.id === entry.id);
const siblings = (await getReadiness()).filter((r) => r.id !== entry.id);
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Readiness', path: '/readiness' }, { name: entry.data.shortTitle, path }];
const graph = [
  webPage(path, entry.data.title, entry.data.description),
  breadcrumbs(crumbs),
  article({ path, headline: entry.data.title, description: entry.data.description, published: entry.data.published, updated: entry.data.updated, type: 'TechArticle', keywords: [entry.data.keyword, 'MLSecOps', entry.data.framework] }),
  faqPage(entry.data.faq, path),
];
const itemCount = entry.data.checklist.reduce((n, s) => n + s.items.length, 0);
---
<Base title={entry.data.title} description={entry.data.description} {path} graph={graph} type="article" published={entry.data.published} updated={entry.data.updated}>
  <section class="wrap py-12 md:py-16">
    <Breadcrumbs items={crumbs} />
    <p class="kicker mt-6">Readiness · {entry.data.framework}</p>
    <h1 class="mt-3">{entry.data.title.replace(/\s*\|\s*MLSecOpsHub$/, '')}</h1>
    <p class="answer mt-5">{entry.data.answer}</p>
    <p class="mono mt-4 text-xs muted">Official source: <a href={entry.data.officialSource.url} rel="noopener">{entry.data.officialSource.label}</a> · Updated <time datetime={entry.data.updated.toISOString()}>{entry.data.updated.toISOString().slice(0, 10)}</time></p>
    <p class="mt-6 flex flex-wrap gap-3">
      <a href={`/downloads/${entry.id}-checklist.pdf`} class="btn btn-secondary" data-goal="pdf" data-event="Download">Checklist PDF ({itemCount} items)</a>
      <a href={`/downloads/${entry.id}-checklist.md`} class="btn btn-secondary" data-goal="md" data-event="Download">Checklist Markdown</a>
    </p>
  </section>

  <div class="wrap"><CtaBlock id="rd-cta" heading="Have this run against your pipeline" body={`The ${entry.data.shortTitle} mapping below is generic. The ${service.data.shortTitle} engagement applies it to your systems, verifies each claim and produces the evidence file.`} /></div>

  <section class="wrap py-14" aria-labelledby="map-h">
    <p class="kicker">Mapping</p>
    <h2 id="map-h" class="mt-2">{entry.data.shortTitle} obligations mapped to MLSecOps controls</h2>
    <p class="muted mt-2 max-w-prose text-sm">Obligations are paraphrased and cited to the official text; they are not the legal wording. Controls are what MLSecOpsHub implements; evidence is what an auditor is shown.</p>
    <div class="mt-6 overflow-x-auto">
      <table>
        <thead><tr><th scope="col">Obligation (paraphrased)</th><th scope="col">Reference</th><th scope="col">MLSecOps control</th><th scope="col">Evidence</th></tr></thead>
        <tbody>
          {entry.data.controls.map((c) => (
            <tr>
              <td>{c.obligation}</td>
              <td class="mono text-xs whitespace-nowrap">{c.reference}</td>
              <td>{c.control}</td>
              <td class="muted">{c.evidence}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="wrap pb-14 grid gap-12 lg:grid-cols-[2fr_1fr]">
    <div class="prose">
      <Content />
      <h2 id="checklist">{entry.data.shortTitle} checklist</h2>
      <p>The same checklist is available as <a href={`/downloads/${entry.id}-checklist.md`} data-goal="md" data-event="Download">Markdown</a> and <a href={`/downloads/${entry.id}-checklist.pdf`} data-goal="pdf" data-event="Download">PDF</a>. Items are written so that each one is either done or not.</p>
      {entry.data.checklist.map((s) => (
        <section>
          <h3>{s.section}</h3>
          <ul>{s.items.map((i) => <li>{i}</li>)}</ul>
        </section>
      ))}
      <Faq items={entry.data.faq} id="rd-faq" />
    </div>
    <aside class="space-y-6 self-start lg:sticky lg:top-24">
      <div class="panel p-5">
        <p class="kicker">Implemented by</p>
        <p class="mt-2 font-semibold"><a href={`/services/${service.id}`}>{service.data.shortTitle}</a></p>
        <p class="muted mt-1 text-sm">{service.data.summary}</p>
      </div>
      <div class="panel p-5">
        <p class="kicker">Threat evidence</p>
        <p class="muted mt-2 text-sm">Disclosed incidents behind these controls: the <a href="/data">Agentic Attack Index</a>.</p>
      </div>
      {notes.length > 0 && (
        <div class="panel p-5">
          <p class="kicker">Case notes</p>
          <ul class="mt-2 space-y-1.5 text-sm">{notes.map((n) => <li><a href={`/case-notes/${n.id}`}>{noteTitle(n.data.title)}</a></li>)}</ul>
        </div>
      )}
      <div class="panel p-5">
        <p class="kicker">Other frameworks</p>
        <ul class="mt-2 space-y-1.5 text-sm">{siblings.map((r) => <li><a href={`/readiness/${r.id}`}>{r.data.shortTitle}</a></li>)}</ul>
      </div>
    </aside>
  </section>
  <div class="wrap pb-6"><CtaBlock id="rd-cta-2" variant="plain" heading="Have this run against your pipeline" /></div>
</Base>
