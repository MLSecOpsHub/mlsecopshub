# Copy to .env for local builds. All PUBLIC_* values are inlined at build time.
PUBLIC_BOOKING_URL=https://cal.com/riccardobiosas/30min
PUBLIC_CAL_LINK=riccardobiosas/30min
PUBLIC_ANALYTICS_DOMAIN=mlsecopshub.com
PUBLIC_ANALYTICS_SCRIPT=https://plausible.io/js/script.outbound-links.file-downloads.tagged-events.js
PUBLIC_FORM_ENDPOINT=/api/contact
PUBLIC_CONTACT_EMAIL=hello@mlsecopshub.com
PUBLIC_GITHUB_LIST_REPO=RiccardoBiosas/awesome-MLSecOps
PUBLIC_GITHUB_DATA_REPO=MLSecOpsHub/agentic-attack-index
PUBLIC_LINKEDIN_URL=
# Optional: raises the GitHub API rate limit during builds (read-only token, no scopes needed)
GITHUB_TOKEN=
# Contact form delivery (used by api/contact.ts, server-side only)
CONTACT_TO_EMAIL=hello@mlsecopshub.com
RESEND_API_KEY=
CONTACT_WEBHOOK_URL=
